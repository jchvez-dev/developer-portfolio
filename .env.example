# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to '.env' and modify the values for your local environment.
# ==============================================================================

NODE_ENV=development
FRONTEND_PORT=3000

# NestJS API Gateway
# ------------------------------------------------------------------------------
# NEST_PORT is the port exposed on your local host computer.
NEST_PORT=4000

# MinIO Object Storage
# ------------------------------------------------------------------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=admin_user_here
MINIO_ROOT_PASSWORD=secure_password_here
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# Inter-container Communication & Security
# ------------------------------------------------------------------------------
PHP_BACKEND_URL=http://backend-php:8000
CORS_ORIGINS=http://localhost:3000

# LLM Provider (Groq)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192
