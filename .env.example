# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to '.env' and modify the values for your local environment.
# ==============================================================================

NODE_ENV=development
FRONTEND_PORT=3000

# NestJS API Gateway
# ------------------------------------------------------------------------------
# NEST_PORT is the port exposed on your local host computer.
NEST_PORT=4000

# S3-Compatible Object Storage
# ------------------------------------------------------------------------------
# BUCKET_API_PORT / BUCKET_CONSOLE_PORT solo aplican al MinIO local (docker-compose).
BUCKET_API_PORT=9000
BUCKET_CONSOLE_PORT=9001
# MinIO local (dev):  BUCKET_ENDPOINT=http://storage:9000
BUCKET_ENDPOINT=http://storage:9000
BUCKET_ACCESS_KEY_ID=admin_user_here
BUCKET_SECRET_ACCESS_KEY=secure_password_here
BUCKET_REGION=us-east-1

# Inter-container Communication & Security
# ------------------------------------------------------------------------------
PHP_BACKEND_URL=http://backend-php:8000
CORS_ORIGINS=http://localhost:3000

# LLM Provider (Groq)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# SMTP (Email notifications for contact form)
# ------------------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=juan@example.com
